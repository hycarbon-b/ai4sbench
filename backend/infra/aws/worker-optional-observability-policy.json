{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOnlyThisArtifactPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::${ARTIFACT_BUCKET}/runs/${RUN_ID}/*"
    },
    {
      "Sid": "WriteWorkerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/ai4sbench/workers:log-stream:*"
    }
  ]
}
