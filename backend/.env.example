# Generate both secrets independently, for example with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TBCP_ENVIRONMENT=production
TBCP_HOST=0.0.0.0
TBCP_PORT=8080
TBCP_ALLOWED_HOSTS=dashboard.ai4sbench.org,127.0.0.1,localhost
TBCP_CORS_ORIGINS=https://ai4s-bench.github.io,https://ai4sbench.org
TBCP_DATABASE_URL=sqlite:////var/lib/ai4sbench/control-panel.sqlite3
TBCP_AUTO_CREATE_SCHEMA=false
TBCP_JOB_TOKEN_SECRET=replace-with-another-32-random-characters
TBCP_AUTH_JWT_SECRET=replace-with-a-third-32-random-characters

# Register an OAuth App at GitHub with callback URL:
# https://dashboard.ai4sbench.org/auth/github/callback
# The OAuth App needs read:user, user:email and public_repo scopes. Repository and
# category node IDs are safe identifiers; OAuth client secret is not.
TBCP_GITHUB_OAUTH_CLIENT_ID=
TBCP_GITHUB_OAUTH_CLIENT_SECRET=
TBCP_GITHUB_REPOSITORY=owner/repository
TBCP_GITHUB_REPOSITORY_NODE_ID=
TBCP_GITHUB_DISCUSSION_CATEGORY_ID=
# First-party operator accounts only. Everyone else is a normal member.
TBCP_ADMIN_GITHUB_LOGINS=
TBCP_ADMIN_GITHUB_EMAILS=
# Only these GitHub users (plus administrators) may publish machine-readable review replies.
TBCP_REVIEWER_GITHUB_LOGINS=

TBCP_EXECUTION_MODE=ec2
TBCP_MAX_ACTIVE_RUNS=1
TBCP_QUEUE_POLL_SECONDS=1
TBCP_JOB_LEASE_SECONDS=120
TBCP_WORKER_API_BASE_URL=https://control.example.com
TBCP_ENABLE_QUICK_TUNNEL=true

# Free-plan E2E profile.  boto3 reads these standard variables directly;
# do not put them in source control or return them from the control panel.
AWS_ACCESS_KEY_ID=replace-with-root-access-key-id-for-temporary-test
AWS_SECRET_ACCESS_KEY=replace-with-root-secret-access-key-for-temporary-test
TBCP_AWS_REGION=us-east-1
# Use AWS's public Amazon Linux 2023 AMI and install the published Harbor
# package on first boot.  Set baked_ami only after publishing a worker image.
TBCP_EC2_BOOTSTRAP_MODE=amazon_linux_2023
TBCP_EC2_AMI_ID=ami-xxxxxxxx
TBCP_EC2_INSTANCE_TYPE=m7i-flex.xlarge
TBCP_EC2_ALLOWED_INSTANCE_TYPES=t3.micro,t3.small,t4g.micro,t4g.small,c7i-flex.large,c7i-flex.xlarge,m7i-flex.large,m7i-flex.xlarge,m7i.2xlarge
TBCP_EC2_ROOT_VOLUME_GB=40
TBCP_EC2_ASSOCIATE_PUBLIC_IP=true
TBCP_EC2_SUBNET_ID=subnet-xxxxxxxx
TBCP_EC2_SECURITY_GROUP_IDS=sg-xxxxxxxx
# Leave empty for the temporary root-key / Free-plan test.  The worker does
# not need AWS API access in the callback-based design.
TBCP_EC2_INSTANCE_PROFILE_ARN=

# Optional for private GitHub repositories or higher API rate limits.
TBCP_GITHUB_TOKEN=
# Optional local HTTP proxy for Git fetches. Leave empty in normal deployments.
TBCP_GIT_HTTPS_PROXY=
